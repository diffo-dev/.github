    [from: :dream_engine, type: "FLUENT_IN", to: :logic_artefact],
    [from: :dream_engine, type: "FLUENT_IN", to: :text_artefact],
    [from: :dream_engine, type: "FLUENT_IN", to: :maths_artefact],
    [from: :dream_engine, type: "FLUENT_IN", to: :dream_artefact],
