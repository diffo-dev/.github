ArtefactKino.new(my_dreaming_mind_realized_artefact)
```

### My Mind Holistically

My Mind is Realized Holistically with Engines fluent in Artefacts.

```elixir
my_mind_holistically_artefact = 
  my_mind_realized_artefact
  |> Artefact.combine(my_kinship_mind_realized_artefact)
  |> Artefact.combine(my_ancestor_mind_realized_artefact)
  |> Artefact.combine(my_story_mind_realized_artefact)
  |> Artefact.combine(my_pattern_mind_realized_artefact)
  #|> Artefact.combine(my_dreaming_mind_realized_artefact)
  #title: "My Mind is Realized Holistically", 
  #description: "My Mind is Realized Holistically with Engines fluent in Artefacts.")

ArtefactKino.new(my_mind_holistically_artefact)
```

## Persistence

```elixir
if path do
  thinking_path = path <> "/thinking/"
  File.mkdir_p!(Path.dirname(thinking_path))
  File.write!(thinking_path <> "my_mind_realized.bin", :erlang.term_to_binary(my_mind_realized_artefact))
  File.write!(thinking_path <> "my_kindship_mind_realized.bin", :erlang.term_to_binary(my_kinship_mind_realized_artefact))
  File.write!(thinking_path <> "my_ancestor_mind_realized.bin", :erlang.term_to_binary(my_ancestor_mind_realized_artefact))
  File.write!(thinking_path <> "my_story_mind_realized.bin", :erlang.term_to_binary(my_story_mind_realized_artefact))
  File.write!(thinking_path <> "my_pattern_mind_realized.bin", :erlang.term_to_binary(my_pattern_mind_realized_artefact))
  File.write!(thinking_path <> "my_dreaming_mind_realized.bin", :erlang.term_to_binary(my_dreaming_mind_realized_artefact))
  File.write!(thinking_path <> "my_mind_holistically.bin", :erlang.term_to_binary(my_mind_holistically_artefact))
end

```

